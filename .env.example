PAYLOAD_SECRET=mygeneratedsecret
# Base MongoDB connection string (without database name)
DATABASE_URL=mongodb://127.0.0.1
# Main database name — appended to DATABASE_URL for MongoDB (avoids defaulting to "test")
DB_NAME=gc-appliances

TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Resend (form emails, password reset, order access links)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME="Your Store"

# Vercel Blob storage (set automatically when Blob is added in Vercel)
BLOB_READ_WRITE_TOKEN=

# Razorpay — both server-only (never use NEXT_PUBLIC_ for these)
RAZORPAY_API_KEY=rzp_test_
RAZORPAY_SECRET_KEY=
